# Copy to apps/api/.env. Provider names are resolved by apps/api/app/core/providers.py (MVP).
LLM_PROVIDER=anthropic          # anthropic | openai | ollama
LLM_MODEL=claude-sonnet-5-5
EMBED_PROVIDER=openai           # openai | ollama
EMBED_MODEL=text-embedding-3-small

# Keys: ANTHROPIC_API_KEY for LLM_PROVIDER=anthropic; OPENAI_API_KEY for an openai LLM or
# embeddings; ollama needs none. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# In Docker, use http://host.docker.internal:11434 to reach Ollama on the host.
OLLAMA_BASE_URL=http://localhost:11434

DATABASE_URL=postgresql+psycopg://ragidy:ragidy@localhost:5432/ragidy

# Object storage (SeaweedFS via the S3 API). In compose, the credentials are also the SeaweedFS S3
# admin identity, and the container will not start without them. Never commit them.
# For local SeaweedFS they are not provider keys: pick any random values, e.g. `openssl rand -hex 20`.
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=ragidy
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Per-tier limits. Sizes are in MiB. Types are a comma-separated subset of pdf, docx, txt, md, html.
UPLOAD_MAX_MB_GUEST=3
UPLOAD_MAX_MB_USER=5
UPLOAD_TYPES_GUEST=pdf,docx,txt,md,html
UPLOAD_TYPES_USER=pdf,docx,txt,md,html
MAX_DOCS_GUEST=3
MAX_DOCS_USER=20
GUEST_TTL_DAYS=7
SESSION_TTL_DAYS=30

# Auth. AUTH_SECRET signs OAuth state cookies. It needs at least 32 characters, e.g.
# `openssl rand -hex 32`, and is required when any OAuth provider is set.
# A provider is enabled when its client id is set. PUBLIC_BASE_URL is the web origin; the browser
# will reach the API under `/api` once the web proxy lands (roadmap step 14).
# Register `<PUBLIC_BASE_URL>/api/auth/oauth/<provider>/callback` as the redirect URI at each
# provider (<provider> is google or github). Never commit real values.
AUTH_SECRET=
PUBLIC_BASE_URL=http://localhost:5173
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Rate limits and abuse. Limits are per client IP, using the socket peer address.
# TRUSTED_PROXIES is a comma-separated list of IPs or CIDRs of your reverse proxies. Forwarded
# headers are honoured only from them, and an empty list trusts none. Login failures count per
# email and IP.
RATE_LIMIT_AUTH_PER_MINUTE=10
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
TRUSTED_PROXIES=
GUEST_CREATE_PER_IP_PER_HOUR=10
CHAT_MESSAGES_PER_HOUR_GUEST=20
CHAT_MESSAGES_PER_HOUR_USER=100
