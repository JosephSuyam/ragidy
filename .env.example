# Copy to apps/api/.env. Provider names are resolved by apps/api/app/core/providers.py (MVP).
LLM_PROVIDER=anthropic          # anthropic | openai | ollama
LLM_MODEL=claude-sonnet-5-5
EMBED_PROVIDER=openai           # openai | ollama
EMBED_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DATABASE_URL=postgresql+psycopg://ragidy:ragidy@localhost:5432/ragidy

# Object storage (SeaweedFS via the S3 API). In compose, the credentials are also the SeaweedFS S3
# admin identity, and the container will not start without them. Never commit them.
# For local SeaweedFS they are not provider keys: pick any random values, e.g. `openssl rand -hex 20`.
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=ragidy
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
